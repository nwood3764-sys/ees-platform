<?xml version="1.0" encoding="UTF-8"?>
<!--
  LEAP — Log Email  ·  Microsoft Outlook add-in manifest (classic XML)

  Adds a "Log to LEAP" button to the Outlook ribbon when reading a message.
  The button opens a task pane (taskpane.html) that lets the user sign in to
  LEAP, search for a record (opportunity, property, account, contact, project,
  work order), and log the currently open email onto that record's
  Conversations timeline — the Salesforce "Log Email to Record" workflow.

  Hosting: all URLs point at the LEAP app's Netlify site (ees-ops), served as
  static files under /outlook-addin/. Deploy to Microsoft 365 by uploading this
  manifest in the Microsoft 365 admin center (Integrated apps → Upload custom
  app), or sideload it per-user (Outlook → Get Add-ins → My add-ins → Add a
  custom add-in → Add from file).
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>6b8e5f2a-1c3d-4e7b-9a2f-7d4c1e9b0a56</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>Energy Efficiency Services</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="LEAP — Log Email"/>
  <Description DefaultValue="Log the open email onto a LEAP record — opportunity, property, account, contact, project, or work order — including attachments."/>
  <IconUrl DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://leap.energyefficiencyservices.org/"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <!-- Fallback task pane for older clients that don't read VersionOverrides. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadItem is sufficient to read the message body and download attachment
       content via getAttachmentContentAsync. -->
  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFile"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="leapLogGroup">
                <Label resid="groupLabel"/>
                <Control xsi:type="Button" id="leapLogButton">
                  <Label resid="buttonLabel"/>
                  <Supertip>
                    <Title resid="buttonLabel"/>
                    <Description resid="buttonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                    <!-- Pinnable pane: the user can pin it open and it stays up
                         as they move between emails (Salesforce-style). The
                         task pane handles Office ItemChanged to refresh. -->
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <!-- Activate the add-in on messages in shared mailboxes / delegated
               folders (EES program mailboxes: EES-WI_Sealed, WI-IRA, WI
               Assessments, NC-IRA, etc.), not just the user's primary mailbox.
               Requires a client on Mailbox requirement set 1.8+. -->
          <SupportsSharedFolders>true</SupportsSharedFolders>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/assets/icon-16.png"/>
        <bt:Image id="icon32" DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/assets/icon-32.png"/>
        <bt:Image id="icon80" DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/taskpane.html"/>
        <bt:Url id="functionFile" DefaultValue="https://leap.energyefficiencyservices.org/outlook-addin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="LEAP"/>
        <bt:String id="buttonLabel" DefaultValue="Log to LEAP"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonTip" DefaultValue="Log this email onto a LEAP record — opportunity, property, account, contact, project, or work order."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
